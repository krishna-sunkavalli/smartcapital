# Alpaca (market data + orders). REQUIRED: set to "paper" or "live" explicitly.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ENV=

# Fundamentals, earnings, and news come from Yahoo Finance via yfinance -
# keyless, no API key required.

# Analyst LLM runs on Azure AI Foundry via Entra (no API key). When running
# locally, `az login` supplies the credential; in Azure the container's
# user-assigned managed identity is used (AZURE_CLIENT_ID is injected).
# Optional local override of the Foundry project endpoint:
# AZURE_AI_PROJECT_ENDPOINT=
# Offline testing (Path A): stub the analyst so the pipeline runs with no Azure.
# SMARTCAPITAL_LLM_DRY_RUN=1

# Telegram approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
